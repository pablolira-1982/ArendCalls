# ==============================================================================
# ArendCalls — Variáveis de Ambiente (Preencha antes de iniciar em produção)
# ==============================================================================

# Chave Mestra global para autenticação na API do ArendCalls
API_KEY=

# Login do Painel Web (opcional — gere o hash com: ./arendcalls -hash-password)
ADMIN_USER=
ADMIN_PASSWORD_HASH=

# Intervalo do worker de keepalive de presença do WhatsApp (ex: 24h, 12h, 1h)
WA_PRESENCE_INTERVAL=

# Chave AES-256-GCM para criptografia de credenciais B2 e Webhooks no banco SQLite (32+ bytes)
RECORDING_CONFIG_KEY=

# Ajustes de performance do runtime Go
GOGC=
GOMEMLIMIT=
